{
  "expo": {
    "name": "Vibe Out",
    "slug": "bill-split-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "billsplitmobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#160A2B",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#160A2B"
      },
      "package": "com.maginfosystems.vibeout",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#160A2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Vibe Out uses Face ID so you can open the app without typing."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vibe Out uses your location to suggest restaurants, bars and cafés near you."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Vibe Out uses your contacts so you can quickly add friends to a party or bill."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Vibe Out uses your camera to scan bills and menus, and to take party photos.",
          "photosPermission": "Vibe Out lets you pick bill, menu and party photos from your gallery.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fd2ebf8c-9576-4007-8202-e55857696902"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fd2ebf8c-9576-4007-8202-e55857696902"
    },
    "ios": {
      "bundleIdentifier": "com.maginfosystems.vibeout"
    }
  }
}
